# Reglas udev para la pantalla LCD del disipador AIO Thermalright Trofeo
# (y otras pantallas LCD basadas en HID compatibles con Thermal Engine).
#
# Permiten que Thermal Engine acceda al dispositivo HID SIN privilegios de root.
#
# Instalación:
#   sudo cp scripts/99-thermalright-trofeo.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   (desconecta y vuelve a conectar el disipador por USB)
#
# La etiqueta "uaccess" concede acceso al usuario de la sesión activa
# (funciona en Bazzite/Fedora con systemd-logind). El GROUP="plugdev" se
# incluye como alternativa para distribuciones que usan ese grupo.

# --- Thermalright Trofeo (VID 0x0416 / PID 0x5302) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5302", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5302", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# --- Thermalright Trofeo Vision 9.16 LCD, protocolo LY bulk (VID 0x0416 / PID 0x5408) ---
# Es la variante real usada por device_ly.py via libusb/pyusb.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5408", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5408", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# --- Variante alternativa declarada en constants.py (VID 0x35CC / PID 0x0104) ---
SUBSYSTEM=="usb", ATTRS{idVendor}=="35cc", ATTRS{idProduct}=="0104", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="35cc", ATTRS{idProduct}=="0104", MODE="0660", GROUP="plugdev", TAG+="uaccess"
